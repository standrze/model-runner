+    private func makeTable(
+        _ pieces: [Int: String],
+        addedTokens: [AddedToken] = []
+    ) throws -> ByteLevelIncrementalDecodingTable {
+        let tokenizerConfig = try config([
+            "tokenizer_class": "PreTrainedTokenizerFast"
+        ])
+        let tokenizerData = try config([
+            "model": [
+                "type": "BPE",
+                "vocab": Dictionary(uniqueKeysWithValues: pieces.map { ($0.value, $0.key) }),
+                "merges": [[String]](),
+            ] as [String: Any]
+        ])
+        let addedTokenIDs = Dictionary(
+            uniqueKeysWithValues: addedTokens.map { ($0.content, $0.id) })
+        let model = try BPETokenizer(
+            tokenizerConfig: tokenizerConfig,
+            tokenizerData: tokenizerData,
+            addedTokens: addedTokenIDs)
+        let maximumTokenID = max(
+            pieces.keys.max() ?? -1,
+            addedTokens.map(\.id).max() ?? -1)
+
+        return try #require(
+            ByteLevelIncrementalDecodingTable(
+                model: model,
+                tokenCount: maximumTokenID + 1,
+                addedTokens: Set(addedTokenIDs.keys)))
+    }
