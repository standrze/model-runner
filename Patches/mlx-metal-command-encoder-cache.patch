+void set_command_encoder_cache_enabled(bool enabled) {
+  // Bit zero is the switch and the upper bits are the invalidation generation.
+  // A CAS changes both in one publication while advancing the generation.
+  auto current = command_encoder_cache_state.load(std::memory_order_relaxed);
+  while (true) {
+    auto next = (current + 2) & ~command_encoder_cache_enabled_bit;
+    if (enabled) {
+      next |= command_encoder_cache_enabled_bit;
+    }
+    if (command_encoder_cache_state.compare_exchange_weak(
+            current, next, std::memory_order_acq_rel, std::memory_order_acquire)) {
+      return;
+    }
+  }
+}
+
+bool is_command_encoder_cache_enabled() {
+  return (command_encoder_cache_state.load(std::memory_order_acquire) &
+          command_encoder_cache_enabled_bit) != 0;
+}
+
+void invalidate_command_encoder_cache() {
+  // clear_streams() is already required to be externally serialized against
+  // evaluation. Bumping first makes every thread-local pointer stale before
+  // either encoder map destroys its elements.
+  command_encoder_cache_state.fetch_add(2, std::memory_order_acq_rel);
+}
