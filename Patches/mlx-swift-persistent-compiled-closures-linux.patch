+    /// Apply the one persistent public-compile handle used only by stateless functions.
+    /// The older Linux revision enters `innerCall` under the instance lock; retain its
+    /// established lock order and acquire `evalLock` for construction and application.
+    private func persistentStatelessCall(_ arguments: [MLXArray]) -> [MLXArray] {
+        evalLock.lock()
+        defer { evalLock.unlock() }
+
+        guard let compiled = persistentCompiledClosureHandle() else { return [] }
+
+        let inputVector = new_mlx_vector_array(arguments)
+        defer { mlx_vector_array_free(inputVector) }
+
+        var resultVector = mlx_vector_array_new()
+        let applyStatus = mlx_closure_apply(&resultVector, compiled.handle, inputVector)
+        defer { mlx_vector_array_free(resultVector) }
+
+        guard applyStatus == 0 else { return [] }
+        return mlx_vector_array_values(resultVector)
+    }
