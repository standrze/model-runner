+extern "C" int mlx_set_metal_command_encoder_cache_enabled(bool enabled) {
+  try {
+    mlx::core::metal::set_command_encoder_cache_enabled(enabled);
+  } catch (std::exception& e) {
+    mlx_error(e.what());
+    return 1;
+  }
+  return 0;
+}
+extern "C" int mlx_get_metal_command_encoder_cache_enabled(bool* enabled) {
+  try {
+    *enabled = mlx::core::metal::is_command_encoder_cache_enabled();
+  } catch (std::exception& e) {
+    mlx_error(e.what());
+    return 1;
+  }
+  return 0;
+}
