+/// Enable or disable persistent C closure handles for stateless compiled functions.
+///
+/// The experimental fast path is process-global and disabled by default. Compiled
+/// functions with observed input or output state always retain the existing transient
+/// wrapper path.
+public func setPersistentCompiledClosuresEnabled(_ enabled: Bool) {
+    withEvalLock {
+        persistentCompiledClosuresFlag = enabled
+    }
+}
+
+/// Return whether persistent stateless compiled closure handles are enabled.
+public func persistentCompiledClosuresEnabled() -> Bool {
+    withEvalLock {
+        persistentCompiledClosuresFlag
+    }
+}
+
+/// Read the flag without recursively acquiring `evalLock` on the compiled hot path.
+///
+/// - Precondition: `evalLock` is held by the caller.
+@inline(__always)
+private func persistentCompiledClosuresEnabledAssumingEvalLock() -> Bool {
+    #if DEBUG
+        EvalLockOwnership.requireHeldByCurrentThread(
+            "the persistent compiled closure flag was read without evalLock")
+    #endif
+    return persistentCompiledClosuresFlag
+}
+
+private final class OwnedMLXClosure: @unchecked Sendable {
+    let handle: mlx_closure
+
+    init(_ handle: mlx_closure) {
+        self.handle = handle
+    }
+
+    deinit {
+        _ = mlx_closure_free(handle)
+    }
+}
