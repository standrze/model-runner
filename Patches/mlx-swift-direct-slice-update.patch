 // MARK: - index set (slice)
 
+extension MLXArray {
+
+    /// Replace a slice using explicit bounds while preserving this array's object identity.
+    ///
+    /// This is the direct counterpart to a slice subscript assignment for callers that already
+    /// have normalized, full-rank bounds and an update with the exact slice shape. It avoids the
+    /// index-operation expansion, reshape, and broadcast work performed by the general setter.
+    /// Each bounds array must contain one entry per source dimension. Bounds must be normalized,
+    /// strides must be positive, and `update` must have the same dtype and exact slice shape.
+    /// These invariants are asserted in debug builds and forwarded directly to MLX in release
+    /// builds so this method remains suitable for latency-sensitive inner loops.
+    ///
+    /// - Parameters:
+    ///   - update: array whose shape exactly matches the selected slice
+    ///   - starts: inclusive start for each source dimension
+    ///   - ends: exclusive end for each source dimension
+    ///   - strides: stride for each source dimension
+    ///   - stream: stream or device on which to create the update
+    public func updateSlice(
+        with update: MLXArray,
+        starts: [Int32],
+        ends: [Int32],
+        strides: [Int32],
+        stream: StreamOrDevice = .default
+    ) {
+        assert(
+            starts.count == ndim && ends.count == ndim && strides.count == ndim,
+            "slice bounds must contain one entry per source dimension")
+        assert(
+            {
+                guard update.dtype == dtype else { return false }
+                for axis in 0 ..< ndim {
+                    let start = starts[axis]
+                    let end = ends[axis]
+                    let stride = strides[axis]
+                    let size = Int32(dim(axis))
+                    guard start >= 0, start <= end, end <= size, stride > 0 else {
+                        return false
+                    }
+                    let sliceSize = (end - start + stride - 1) / stride
+                    guard update.dim(axis) == Int(sliceSize) else { return false }
+                }
+                return true
+            }(),
+            "update must match the normalized slice shape and dtype")
+
+        var result = mlx_array_new()
+        mlx_slice_update(
+            &result,
+            ctx, update.ctx,
+            starts, starts.count,
+            ends, ends.count,
+            strides, strides.count,
+            stream.ctx)
+        _updateInternal(MLXArray(result))
+    }
+}
+
 /// The result of translating index operations into `mlx_slice_update*` arguments.
 ///
 /// See ``sliceUpdateArguments(src:operations:update:stream:)``.
