+                "There is no Stream(gpu, {}) in current thread.", s.index));
+      }
+    }
+    return it->second;
+  }
+
+  auto& cached = last_command_encoder();
+  if (cached.generation_state == cache_state &&
+      cached.stream_index == s.index &&
+      cached.encoder != nullptr) {
+    return *cached.encoder;
+  }
